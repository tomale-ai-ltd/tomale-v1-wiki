											"pm.test(\"8B-1: 200\", () => pm.response.to.have.status(200));",
											"const u = j().user || {}; const ap = (j().auth || {}).active_profile || j().active_profile || {};",
											"pm.test(\"8B-1: email not confirmed\", () => pm.expect(u.email_verified === true).to.eql(false));",
											"pm.test(\"8B-1: onboarding not complete\", () => pm.expect(u.onboarding_complete === true).to.eql(false));",
											"pm.test(\"8B-1: active profile is the primary parent, named Postman\", () => { pm.expect(ap.is_primary).to.eql(true); pm.expect(ap.is_child).to.eql(false); pm.expect(ap.name).to.eql(\"Postman\"); });"
